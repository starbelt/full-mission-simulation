# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Virtual environments
.venv/

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# PlatformIO / Zephyr build outputs. esp32/.pio alone is ~20 MB of .elf and
# .map; the Zephyr build is staged outside the repo (see esp32/build_zephyr.sh)
# so it never lands here.
.pio/
*.elf
*.map
*.bin
*.hex

# Scratch files from ad-hoc host probes. Real code lives in esp32/host_test/,
# esp32/src/ and esp32/zephyr/.
esp32/scratch_*
.probe/
.probe.py
smoke.cpp
smoke.exe

# Raw HIL captures, Zephyr build trees, and audit scratch under results/.
# Only the small summaries are tracked: REPORT.md, audit.json, summary.json,
# manifest.json, metrics.csv, verification.json, plots. The raw wire/frame
# captures (*.jsonl) and staged build trees are regenerable and total ~2.3 GB.
results/**/*.jsonl
results/**/*.log
results/**/*.exit
results/**/*.obj
results/**/*.pickle
results/**/*.su
results/**/*.dts
results/**/*.dtsi
results/**/*.exe
results/**/target/
results/**/target_pre_tail_trim/
results/**/*_build/
results/**/handoff_sources/
results/**/__pycache__/
# Full build-audit provenance dumps (several MB per version) and per-frame
# simulation traces. The compact audit.json/summary.json/manifest.json next to
# them are what gets tracked.
results/**/*commands.txt
results/**/*inputs_all.txt
results/**/*header_dependencies.txt
results/**/dependency_hashes.json
results/**/retained_target_hashes.json*
results/adcs_closed_loop/**/*.csv
# Staged build inputs and one-off audit scripts from the firmware runs. The
# compact audit.json/summary.json/REPORT.md next to them carry the findings;
# the headers, symbol/section dumps and tool-version stamps are regenerable
# from the pinned Zephyr tree.
results/**/*.h
results/**/*.py
results/**/*_symbols.txt
results/**/*_sections.txt
results/**/*_size.txt
results/**/*_version.txt
results/**/west_*
results/**/repo_state.txt
results/**/repo_head.txt
results/**/*_pre_tail_trim*
